# Environment variables for xAI Grok integration
# Copy this file to .env and fill in your API key

# OpenRoute API Key for xAI Grok
# Get your API key from: https://openrouter.ai/keys
OPENROUTE_API_KEY=your_openrouter_api_key_here

# Optional: Customize Grok model (default: x-ai/grok-4-fast:free)
# GROK_MODEL_NAME=x-ai/grok-4-fast:free

# Optional: Custom timeout for API calls (default: 30 seconds)
# GROK_TIMEOUT=30